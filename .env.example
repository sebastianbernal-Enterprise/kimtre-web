# Puerto en el que escuchará el servidor Express
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=production

# Correo electrónico de destino para los formularios de contacto
CONTACT_EMAIL=sebastian@kimtre.cl

# Orígenes permitidos adicionales separados por coma (opcional)
# ALLOWED_ORIGINS=https://kimtre.cl,https://www.kimtre.cl

# Cloudflare Turnstile (Opcional - Llave secreta para validación de bot)
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
# TURNSTILE_SITE_KEY=0x4AAAAAA...

# Google reCAPTCHA v3 (Opcional alternativa)
# RECAPTCHA_SECRET_KEY=6Le...
# RECAPTCHA_SITE_KEY=6Le...
